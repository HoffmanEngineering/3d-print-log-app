<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-printlog-native"
        version="1.0.0">
    <name>PrintLog Native Bridge</name>
    <description>
        Origin-restricted native bridge for push registration, notification taps and NFC
        spool tag reading.
        Exists because cordova.js is unavailable once the WebView navigates to the remote
        site, so the Angular app cannot reach plugins the normal way.
    </description>
    <license>AGPL-3.0-only</license>

    <!--
        Deliberately NO js-module. A js-module is injected by cordova.js, which is gone once
        the WebView navigates to https://www.3dprintlog.com. The shim ships as an asset and
        native evaluates it into the page, for the allowed origin only.
    -->

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="PrintLogNative">
                <param name="android-package" value="com.hoffmanengineering.printlog.PrintLogNativePlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <source-file src="src/android/PrintLogNativePlugin.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/PrintLogBridgeRouter.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/SpoolTagRules.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/TagMemory.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/PageDump.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/ClassicDump.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/ReaderConfig.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/ReaderFormat.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/TagKeySchemes.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />
        <source-file src="src/android/TagReader.java"
                     target-dir="app/src/main/java/com/hoffmanengineering/printlog" />

        <asset src="www/printlog-native.js" target="printlog-native.js" />

        <framework src="androidx.webkit:webkit:1.12.1" />
    </platform>

    <!--
        iOS is a Swift package (Package.swift) rather than loose source files: it needs
        FirebaseMessaging and firebasex's message receiver as module imports, and cordova-ios 8
        links only packages that declare them. Package.swift also carries www/printlog-native.js
        as a resource, so the shim stays one file for both platforms.
    -->
    <platform name="ios" package="swift">
        <config-file target="config.xml" parent="/*">
            <feature name="PrintLogNative">
                <param name="ios-package" value="PrintLogNativePlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>
    </platform>
</plugin>
