{
  "name": "com.hoffmanengineering.printlog",
  "displayName": "3D Print Log",
  "version": "1.2.1",
  "description": "Cordova hybrid mobile app for 3D Print Log — log and track your 3D prints, print times, filament usage, and settings.",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:user-agent": "node scripts/check-user-agent-contract.mjs",
    "build:android": "cordova build android",
    "release:android": "cordova build android --prod --release --buildConfig=build.json",
    "build:ios": "cordova build ios",
    "release:ios": "cordova build ios --prod --release --buildConfig=build.json"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Hoffman Engineering",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoffmanEngineering/3d-print-log-app.git"
  },
  "devDependencies": {
    "cordova": "13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^7.1.1",
    "cordova-plugin-customurlscheme": "^5.0.2",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-firebasex-messaging": "^2.0.3",
    "cordova-plugin-network-information": "^3.0.0",
    "cordova-plugin-printlog-native": "file:plugins-local/cordova-plugin-printlog-native"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-dialogs": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-customurlscheme": {
        "URL_SCHEME": "com.hoffmanengineering.printlog",
        "ANDROID_PATHPREFIX": "/cordova/com.hoffmanengineering.printlog/callback",
        "ANDROID_SCHEME": " ",
        "ANDROID_HOST": " "
      },
      "cordova-plugin-firebasex-messaging": {},
      "cordova-plugin-printlog-native": {}
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
