<?xml version='1.0' encoding='utf-8'?>
<widget id="com.hoffmanengineering.printlog" version="1.3.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>3D Print Log</name>
    <description>
        Easily log and track your 3D prints. Record print times, filament usage, settings and more. Quickly search for past 3D prints.
    </description>
    <author email="hello@3dprintlog.com" href="https://www.3dprintlog.com">
        Hoffman Engineering
    </author>
    <content src="index.html" />
    <access origin="*" />
    <icon src="www/img/logo.png" />
    <allow-navigation href="https://www.3dprintlog.com/*" />
    <allow-navigation href="https://*.auth0.com/*" />
    <allow-navigation href="https://*.google.com/*" />
    <!-- <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" /> -->
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidXEnabled" value="true" />
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
            <!-- NFC spool tags. A normal permission (no prompt); required="false" so Play still
                 offers the app to phones without NFC. -->
            <uses-permission android:name="android.permission.NFC" />
            <!-- The buzz when a spool tag is read. Also a normal permission, granted at install. -->
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-feature android:name="android.hardware.nfc" android:required="false" />
        </config-file>
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <!-- App Store Connect rejects a marketing icon that is not 1024x1024 or has an alpha
             channel, and Xcode 26's actool fails the build outright ("AppIcon did not have
             any applicable content") on a smaller one. www/img/logo.png is 180x180 RGBA, so
             iOS gets its own: the same square crop of the brand mark (the UI's 3d_brand_logo
             SVG), rendered at 1024 and flattened. Outside www/ so it is not shipped as web
             content. -->
        <icon src="res/ios/icon-1024.png" width="1024" height="1024" />
        <!-- 15.0 because the Firebase iOS SDK that cordova-plugin-firebasex-messaging pins
             (12.x) declares .iOS(.v15) in its Swift package. Anything lower and Xcode refuses
             to resolve the package graph. -->
        <preference name="deployment-target" value="15.0" />
        <preference name="AllowInlineMediaPlayback" value="true" />
        <!-- Edge swipe goes back through WebView history, the iOS counterpart of
             patch_back_navigation.js. index.js uses location.replace(), so swiping back from
             the site's first page cannot land on the bootstrap page. -->
        <preference name="AllowBackForwardNavigationGestures" value="true" />
        <!-- The launch storyboard has no image, so without this it is a white (or black)
             screen that then jumps to the blue bootstrap page. -->
        <preference name="SplashScreenBackgroundColor" value="#3F50B5" />
        <!-- iOS's own user agent, so the UI can tell the shells apart: App Store rules force
             iOS-only behavior (no Stripe checkout, a different NFC flow) and WKWebView treats
             file inputs differently. Overrides the global one below for iOS only. Must equal
             the UI's CORDOVA_IOS_USER_AGENT; scripts/check-user-agent-contract.mjs checks it. -->
        <preference name="OverrideUserAgent" value="Mozilla/5.0 Google PrintLog-iOS/1.0" />
        <edit-config target="NSCameraUsageDescription" file="*-Info.plist" mode="merge">
            <string>3D Print Log needs camera access to scan QR codes and capture photos of your prints</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryUsageDescription" file="*-Info.plist" mode="merge">
            <string>3D Print Log needs photo library access to select photos of your 3D prints</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryAddUsageDescription" file="*-Info.plist" mode="merge">
            <string>3D Print Log needs photo library access to save photos of your 3D prints</string>
        </edit-config>
        <!-- The app's only encryption is HTTPS through the OS, which is exempt from export
             reporting. Declaring it here stops App Store Connect asking on every build. -->
        <edit-config target="ITSAppUsesNonExemptEncryption" file="*-Info.plist" mode="merge">
            <false/>
        </edit-config>
    </platform>
    <!-- Android's user agent (iOS overrides it in its own block). Must equal the UI's
         CORDOVA_USER_AGENT; scripts/check-user-agent-contract.mjs checks it. -->
    <preference name="OverrideUserAgent" value="Mozilla/5.0 Google PrintLog/1.2" />
    <!--
        Base URL of the 3D Print Log API, used by cordova-plugin-printlog-native to register
        this device for push notifications.

        Read from here rather than accepted from the page on purpose: a page-supplied API
        base would let compromised page script point the native bridge - and the user's
        bearer token - at a server of its choosing.

        Must match the host the UI talks to (the CSP connect-src in the UI's
        staticwebapp.config.json is the authority). If this is ever wrong or empty the plugin
        logs a warning and every registration returns ok:false, so push is simply off rather
        than pointed somewhere wrong.
    -->
    <preference name="PrintLogApiUrl" value="https://api.3dprintlog.com" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#3F50B5" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreen" value="none"/>
    <preference name="SplashScreenDelay" value="0"/>
    <preference name="FadeSplashScreenDuration" value="0"/>
    <hook type="before_compile" src="hooks/before_compile/patch_camera_permission.js" />
    <hook type="before_compile" src="hooks/before_compile/patch_auth_custom_tab.js" />
    <hook type="before_compile" src="hooks/before_compile/patch_back_navigation.js" />
</widget>
